# UniSphere Backend Environment Configuration Template
# Copy this file to .env and configure your local development values.
# WARNING: Do not commit actual credentials or the .env file to version control.

# Local PostgreSQL Development Database Connection String
# CRITICAL SAFETY RULES:
# 1. Seeding against Neon (*.neon.tech) and remote databases is strictly prohibited.
# 2. Database host must be local: localhost, 127.0.0.1, or ::1.
# 3. Database name must be in the approved allowlist: unisphere_db, unisphere_dev, unisphere_development, unisphere_local.
DATABASE_URL=postgresql+psycopg://postgres:localpassword@localhost:5432/unisphere_dev

# Dedicated Local Disposable PostgreSQL Test Database URL (for running isolated integration tests)
# CRITICAL TEST SAFETY RULES:
# 1. Neon hosts (*.neon.tech) and remote hosts are strictly prohibited for integration test execution.
# 2. Host must be local: localhost, 127.0.0.1, or ::1.
# 3. Database name must clearly indicate a disposable test database (must contain 'test', e.g. unisphere_test_db).
# 4. Integration tests require explicit opt-in: set ALLOW_TEST_DB_RESET=true.
# 5. Tests must target a dedicated, disposable local database, never shared development or production.
TEST_DATABASE_URL=postgresql+psycopg://postgres:localpassword@localhost:5432/unisphere_disposable_test_db
ALLOW_TEST_DB_RESET=false
